{
  "name": "toybox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ToyBox — a little box of 2D physics toys for elnuevos.es.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node scripts/bench.mjs",
    "profile": "node scripts/bench.mjs --profile 4 --sizes 2000",
    "shootout": "node bench/run.mjs"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
